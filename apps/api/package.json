{
  "name": "@pricefunc/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "npm run prisma:generate",
    "build": "nest build",
    "pretest": "npm run prisma:generate",
    "test": "vitest run",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "ts-node --transpile-only scripts/prisma.ts generate",
    "prisma:migrate": "ts-node --transpile-only scripts/prisma.ts migrate dev",
    "prisma:migrate:deploy": "ts-node --transpile-only scripts/prisma.ts migrate deploy",
    "prisma:seed": "ts-node --transpile-only prisma/seed.ts",
    "prelint": "npm run prisma:generate",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.12.0",
    "bcrypt": "6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prisma": "6.12.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcrypt": "^5.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.0"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
