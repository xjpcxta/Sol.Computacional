# API and Supabase PostgreSQL database
# Copy the Session Pooler connection string from Supabase > Connect.
DATABASE_URL="postgresql://USER.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3333
CORS_ORIGINS="http://localhost:5173,https://your-project.vercel.app"

# Initial administrator created by the Prisma seed
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="replace-with-a-strong-password"
ADMIN_EMAIL="admin@example.com"

# Optional estimate assistant (backend/Render only — never prefix these with VITE_)
AI_ASSISTANT_ENABLED="false"
AI_API_BASE_URL="https://provider.example/openai/v1"
AI_API_KEY="replace-only-in-local-env-or-render"
AI_MODEL="provider-model-name"
AI_REQUEST_TIMEOUT_MS="30000"
AI_MAX_OUTPUT_TOKENS="1200"
